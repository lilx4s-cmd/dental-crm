coverage

# One-off Bitrix24 import scripts. Never commit: they carry a hardcoded super-admin password and
# their own .env, and they are throwaway tooling rather than part of the product. Ignored rather
# than merely untracked, so a "stage all" in an editor cannot sweep them in.
migration/

# Local PDF preview artefacts, never committed
treatment-plan-sample.pdf
*.tmp.js
*.tmp.pdf

arabic-spike.pdf

# Compiled output belongs in packages/shared/dist, never beside the source. Thirty-six of these
# were committed inside src/ from a historical tsc run without an outDir, and because the API's
# jest resolves .js before .ts, every test importing shared code was reading compiled JavaScript
# from 18 July rather than the source it was meant to describe.
packages/shared/src/**/*.js
packages/shared/src/**/*.d.ts
packages/shared/src/**/*.map

# Render artefacts from the Arabic verification script
arabic-proof.pdf
