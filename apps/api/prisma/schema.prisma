generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum Role {
  SUPER_ADMIN
  CLINIC_MANAGER
  RECEPTION
  SALES_CONSULTANT
  DENTIST
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum LeadSource {
  FACEBOOK_ADS
  INSTAGRAM_ADS
  WHATSAPP
  WEBSITE
  PHONE
  WALK_IN
  REFERRAL
  GOOGLE
  OTHER
}

// The clinic's own sales process, replacing the generic stages this started with.
//
// LOST is kept even though it is not part of the stated flow: it is where a dead deal goes, the
// lost-reason prompt hangs off it, and the deals already sitting there would otherwise have
// nowhere to be. DONE is the win — Lead.status still derives from the stage, so DONE sets WON.
enum PipelineStage {
  NEW_DEAL
  NO_RESPONSE_1
  NO_RESPONSE_2
  NO_RESPONSE_3
  CONTACTED
  WAITING_PHOTOS
  CONSULTATION
  OFFER_SENT
  NEGOTIATION
  WAITING_FOR_TICKET
  TICKET
  SECOND_VISIT
  DONE
  LOST
}

enum LeadStatus {
  ACTIVE
  WON
  LOST
  ARCHIVED
}

enum ResourceType {
  CHAIR
  ROOM
}

enum AppointmentType {
  CONSULTATION
  TREATMENT
  FOLLOW_UP
  CLEANING
  EMERGENCY
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum TreatmentStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSTALLMENT
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InstallmentFrequency {
  WEEKLY
  MONTHLY
}

enum ConversationChannel {
  WHATSAPP
  EMAIL
  SMS
  FACEBOOK_MESSENGER
  IN_APP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallOutcome {
  ANSWERED
  MISSED
  VOICEMAIL
  BUSY
  FAILED
}

enum CampaignPlatform {
  FACEBOOK
  INSTAGRAM
  GOOGLE
  TIKTOK
  OTHER
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum AttachableType {
  PATIENT
  LEAD
  TREATMENT_PLAN
  TREATMENT_PLAN_ITEM
  WARRANTY
  INVOICE
  APPOINTMENT
  USER
  OTHER
}

enum FileCategory {
  XRAY
  CT_SCAN
  PHOTO
  BEFORE_PHOTO
  AFTER_PHOTO
  // Travel paperwork the clinic collects once a deal reaches the ticket stage.
  PASSPORT
  FLIGHT_TICKET
  DOCUMENT
  INVOICE_PDF
  WARRANTY_PDF
  OTHER
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
  IN_APP
  BROWSER_PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOCKOUT
  PASSWORD_RESET
  PASSWORD_CHANGED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  LOGOUT
  EXPORT
  OTHER
}

enum PatientApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOIDED
  CLAIMED
}

enum LabOrderStatus {
  DRAFT
  SENT
  IN_PRODUCTION
  READY
  RECEIVED
  REMAKE
}

enum TimelineStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum CommentAuthorType {
  STAFF
  PATIENT
}

// Findings and proposals that can be recorded against a tooth. Must stay in step with
// ToothCondition in packages/shared/src/dental/tooth-conditions.ts, which is what the dental
// chart renders from — a value here with no counterpart there simply draws as a plain tooth.
enum ToothCondition {
  HEALTHY
  CARIES
  PLAQUE
  AMALGAM_FILLING
  COMPOSITE_FILLING
  MISSING
  FRACTURED
  WORN
  ONLY_ROOT
  ROOT_CANAL_TREATED
  MOBILITY
  RECEDING_BONE
  CYST
  EXTRACTION
  IMPLANT
  CROWN
  VENEER
  BRIDGE
  FILLING
  ROOT_CANAL
  CLEANING
  BONE_GRAFT
  SINUS_LIFT
}

// ─────────────────────────── CORE / AUTH ───────────────────────────

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  avatarUrl        String?
  role             Role
  isActive         Boolean          @default(true)
  employmentStatus EmploymentStatus @default(ACTIVE)
  hireDate         DateTime?
  specialization   String?
  calendarColor    String?
  // TOTP second factor. The secret is stored encrypted at rest (see TwoFactorService) rather than
  // in clear: a leaked database read would otherwise hand over the second factor along with the
  // first, which defeats the point of having one.
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?
  // Failed sign-in tracking. The counter is not reset when the account locks — it keeps climbing
  // so the lock duration can escalate for someone who is clearly guessing, and is cleared only by
  // a successful sign-in. See packages/shared/src/access/lockout.ts.
  failedLoginAttempts Int           @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  refreshTokens               RefreshToken[]
  assignedLeads               Lead[]                   @relation("LeadAssignee")
  leadActivities              LeadActivity[]
  leadTasksAssigned           LeadTask[]               @relation("LeadTaskAssignee")
  leadTasksCreated            LeadTask[]               @relation("LeadTaskCreatedBy")
  intakeReviewed              IntakeSubmission[]       @relation("IntakeReviewedBy")
  patientCommissions          Patient[]                @relation("PatientCommission")
  appointmentsAsDentist       Appointment[]            @relation("AppointmentDentist")
  appointmentsCreated         Appointment[]            @relation("AppointmentCreatedBy")
  treatmentPlans              TreatmentPlan[]          @relation("TreatmentPlanCreatedBy")
  treatmentPlansAsDentist     TreatmentPlan[]          @relation("TreatmentPlanDentist")
  treatmentPlansAsCoordinator TreatmentPlan[]          @relation("TreatmentPlanCoordinator")
  treatmentPlanComments       TreatmentPlanComment[]
  shareLinksCreated           TreatmentPlanShareLink[] @relation("ShareLinkCreatedBy")
  invoicesCreated             Invoice[]                @relation("InvoiceCreatedBy")
  paymentsRecorded            Payment[]                @relation("PaymentCreatedBy")
  conversationsAssigned       Conversation[]           @relation("ConversationAssignee")
  messagesSent                Message[]                @relation("MessageSender")
  callLogs                    CallLog[]                @relation("CallLogUser")
  filesUploaded               File[]                   @relation("FileUploadedBy")
  notifications               Notification[]
  auditLogs                   AuditLog[]
  passwordResetTokens         PasswordResetToken[]
  twoFactorRecoveryCodes      TwoFactorRecoveryCode[]
  labOrdersCreated            LabOrder[]               @relation("LabOrderCreatedBy")

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdByIp         String?
  userAgent           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model ClinicSettings {
  id           String   @id @default("singleton")
  clinicName   String
  address      String?
  city         String?
  country      String?
  timezone     String   @default("Europe/Istanbul")
  logoUrl      String?
  workingHours Json?
  currency     String   @default("USD")
  phone        String?
  email        String?
  whatsapp     String?
  website      String?
  // Defaults every new plan starts from. Set once by the clinic; this is most of the difference
  // between a two-minute proposal and a twenty-minute one.
  defaultPackageIncludes     String[] @default([])
  defaultCardFeePercent      Decimal? @db.Decimal(5, 2)
  defaultCashDiscountPercent Decimal? @db.Decimal(5, 2)
  defaultDepositPercent      Decimal? @db.Decimal(5, 2)
  defaultPaymentTerms        String?
  defaultWarrantyTerms       String?
  updatedAt    DateTime @updatedAt

  @@map("clinic_settings")
}

// ─────────────────────────── PATIENTS / LEADS / PIPELINE ───────────────────────────

model Patient {
  id                  String    @id @default(uuid())
  // Short human-readable case reference — what staff say on the phone, since nobody reads a uuid
  // aloud. Generated by the database from a sequence so two people admitting patients at once
  // cannot land on the same number.
  caseNumber          String?   @unique
  firstName           String
  lastName            String
  email               String?
  phone               String?
  whatsappNumber      String?
  dateOfBirth         DateTime?
  gender              Gender?   @default(UNKNOWN)
  address             String?
  city                String?
  country             String?
  nationalId          String?
  notes               String?
  // Null means nobody has asked yet; an explicit "None" means asked and there are none. The
  // distinction matters — patient-facing documents only print an allergies section when this is
  // set, so a blank is never rendered as a clean bill of health.
  allergies           String?
  // The medical questionnaire the patient answered on the enquiry form. Copied here on conversion
  // rather than left on the lead: a dentist opens the patient record, not the deal that produced
  // it, and declared blood thinners have to be visible where treatment is planned.
  medications         String?
  medicalConditions   String?
  previousSurgeries   String?
  isSmoker            Boolean?
  drinksAlcohol       Boolean?
  isPregnant          Boolean?
  takesBloodThinners  Boolean?
  heightCm            Int?
  weightKg            Int?
  nationality         String?
  // Set when the deal that produced this patient reaches Done. Treatment is finished and the
  // relationship moves from selling to looking after them, which is a different job with different
  // follow-ups — so it is a date, not a flag: how long someone has been in after-care matters.
  aftercareStartedAt  DateTime?
  // Case economics. Only the two figures the clinic actually enters live here — what the case
  // costs them and what the salesperson takes. Price, paid and profit are derived from the
  // existing invoices and payments rather than stored again, so there is one answer to "how much
  // has this patient paid" instead of two that can disagree.
  serviceCost         Decimal?  @db.Decimal(12, 2)
  salesCommission     Decimal?  @db.Decimal(12, 2)
  commissionUserId    String?
  commissionUser      User?     @relation("PatientCommission", fields: [commissionUserId], references: [id])
  diagnosis           String?
  insuranceInfo       String?
  isActive            Boolean   @default(true)
  convertedFromLeadId String?   @unique
  convertedFromLead   Lead?     @relation("LeadToPatient", fields: [convertedFromLeadId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tags           PatientTag[]
  appointments   Appointment[]
  treatmentPlans TreatmentPlan[]
  invoices       Invoice[]
  conversations  Conversation[]
  callLogs       CallLog[]

  @@index([phone])
  @@index([email])
  @@index([isActive, createdAt])
  @@map("patients")
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  patients PatientTag[]

  @@map("tags")
}

model PatientTag {
  patientId String
  tagId     String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([patientId, tagId])
  // The composite primary key already serves lookups by patientId, being the leftmost column, but
  // not by tagId alone — which is the direction the patient list filters in
  // (`where.tags = { some: { tagId } }`, patients.service.ts).
  @@index([tagId])
  @@map("patient_tags")
}

model Campaign {
  id          String           @id @default(uuid())
  name        String
  platform    CampaignPlatform
  externalId  String?
  adAccountId String?
  status      CampaignStatus   @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  budget      Decimal?         @db.Decimal(12, 2)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  leads Lead[]

  // externalId is looked up on every inbound Meta lead-ad webhook, which is an unauthenticated
  // external path — the one place a sequential scan is someone else's to trigger. `name` backs the
  // duplicate check on create; see TECHNICAL_DEBT.md on making that a real unique constraint.
  @@index([externalId])
  @@index([name])
  @@map("campaigns")
}

model Lead {
  id             String        @id @default(uuid())
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  whatsappNumber String?
  source         LeadSource
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id])
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmTerm        String?
  utmContent     String?
  stage          PipelineStage @default(NEW_DEAL)
  status         LeadStatus    @default(ACTIVE)
  assignedToId   String?
  assignedTo     User?         @relation("LeadAssignee", fields: [assignedToId], references: [id])
  estimatedValue Decimal?      @db.Decimal(12, 2)
  currency       String?
  lostReason     String?
  notes          String?
  // When the lead last moved stage. Stored rather than derived from LeadActivity because the
  // kanban needs it for every card at once, and the "no movement" filter has to be a WHERE
  // clause — reconstructing it per lead would be a query per card.
  stageChangedAt DateTime      @default(now())
  // Original Bitrix24 deal ID (recovered from the migration's deterministic
  // id mapping — see migration/import.mjs's detUuid()). Nullable since leads
  // created directly in this CRM never had a Bitrix counterpart. Powers the
  // "Open in Bitrix24" link in the lead detail view.
  bitrixDealId   Int?          @unique
  // Set when this deal was folded into another during duplicate cleanup. The row is kept rather
  // than deleted — it carries whatever somebody wrote against it, and "this enquiry became that
  // deal" is itself worth knowing. Merged deals are filtered out of every board and list query.
  mergedIntoId   String?
  mergedInto     Lead?         @relation("LeadMerge", fields: [mergedIntoId], references: [id])
  mergedFrom     Lead[]        @relation("LeadMerge")
  mergedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  activities    LeadActivity[]
  conversations Conversation[]
  callLogs      CallLog[]
  tasks         LeadTask[]
  intakeSubmissions IntakeSubmission[]
  patient       Patient?       @relation("LeadToPatient")

  @@index([stage])
  @@index([assignedToId])
  @@index([stageChangedAt])
  @@index([mergedIntoId])
  @@index([phone])
  @@index([whatsappNumber])
  // Set by the shared where-builder on every pipeline query, and needed by source attribution.
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([campaignId])
  @@map("leads")
}

// What a prospective patient filled in on the public intake form, kept exactly as they wrote it.
//
// This is a record of what someone declared about themselves at a point in time, so it is stored
// separately from the Lead the submission creates rather than being merged into it — staff correct
// and enrich the lead as they learn more, and that editing must never overwrite what the patient
// originally said about their own health.
model IntakeSubmission {
  id     String @id @default(uuid())
  // Set on submit so the enquiry lands in the pipeline where staff already work, rather than in a
  // separate queue somebody has to remember to check. Nullable and SetNull so deleting a lead
  // does not destroy the declaration that created it.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  firstName          String
  lastName           String
  email              String?
  phone              String?
  whatsappNumber     String?
  dateOfBirth        DateTime?
  gender             Gender?
  nationality        String?
  countryOfResidence String?
  preferredLanguage  String?

  // What they are asking for.
  treatmentInterest String[]
  chiefComplaint    String?
  desiredTimeframe  String?
  openToTravel      Boolean?

  // Medical questionnaire. Every boolean here is tri-state on purpose: null means the question was
  // not answered, which is clinically different from an explicit "no" — the same reasoning as
  // Patient.allergies. Never default these to false.
  allergies          String?
  medications        String?
  medicalConditions  String?
  previousSurgeries  String?
  isSmoker           Boolean?
  drinksAlcohol      Boolean?
  isPregnant         Boolean?
  takesBloodThinners Boolean?
  heightCm           Int?
  weightKg           Int?
  additionalNotes    String?

  // The exact wording the patient agreed to, not just a boolean. Changing the copy later must not
  // retroactively alter what somebody consented to.
  consentedAt DateTime
  consentText String

  // sha256 of a token handed back once on submit; only a caller holding it can attach files. Stored
  // hashed for the same reason TreatmentPlanShareLink.tokenHash is.
  uploadTokenHash String?

  sourceUrl   String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("IntakeReviewedBy", fields: [reviewedById], references: [id])

  attachments IntakeAttachment[]
  createdAt   DateTime           @default(now())

  @@index([leadId])
  @@map("intake_submissions")
}

// Files attached by an anonymous submitter, deliberately held apart from the clinic's File store.
// File.uploadedById is a required relation to User, so an unauthenticated upload cannot write there
// — and it should not: unverified content from a public form has no business in the patient file
// system until a human has looked at it.
model IntakeAttachment {
  id           String           @id @default(uuid())
  submissionId String
  submission   IntakeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  s3Bucket     String
  s3Key        String
  createdAt    DateTime         @default(now())

  @@index([submissionId])
  @@map("intake_attachments")
}

// Credentials for a linked WhatsApp Web session.
//
// Kept in the database rather than on disk because Render's filesystem is ephemeral: every deploy
// and every restart would otherwise wipe the session and force somebody to physically re-scan a
// QR code, which is exactly the failure nobody notices until a patient complains.
//
// Baileys stores its state as many small keyed blobs (the credentials themselves, plus per-device
// pre-key and session records), so this is a key-value table rather than typed columns.
model WhatsAppSession {
  id        String   @id @default(uuid())
  // Which linked number this belongs to. One row set per session; "default" until the clinic ever
  // needs a second number.
  sessionId String   @default("default")
  // Baileys' own key, e.g. "creds", "pre-key-31", "session-4915...".
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([sessionId, key])
  @@index([sessionId])
  @@map("whatsapp_sessions")
}

// A single thing somebody has to do about a lead — "call back", "send photos to the doctor". The
// due date is what drives the pipeline's Today / This week / This month filters, so it is required:
// a task with no date cannot answer "who do I contact now", which is the whole point of having it.
model LeadTask {
  id           String    @id @default(uuid())
  leadId       String
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title        String
  dueDate      DateTime
  assignedToId String?
  assignedTo   User?     @relation("LeadTaskAssignee", fields: [assignedToId], references: [id])
  // Null means open. A timestamp rather than a boolean so "done today" is answerable later.
  completedAt  DateTime?
  createdById  String
  createdBy    User      @relation("LeadTaskCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([leadId])
  @@index([dueDate])
  @@index([assignedToId])
  @@map("lead_tasks")
}

model LeadActivity {
  id        String         @id @default(uuid())
  leadId    String
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?          @relation(fields: [userId], references: [id])
  fromStage PipelineStage?
  toStage   PipelineStage?
  note      String?
  createdAt DateTime       @default(now())

  @@index([leadId])
  @@index([userId, createdAt])
  @@map("lead_activities")
}

// ─────────────────────────── APPOINTMENTS ───────────────────────────

model Resource {
  id       String       @id @default(uuid())
  name     String
  type     ResourceType
  isActive Boolean      @default(true)

  appointments Appointment[]

  @@map("resources")
}

model Appointment {
  id                    String            @id @default(uuid())
  patientId             String
  patient               Patient           @relation(fields: [patientId], references: [id])
  dentistId             String?
  dentist               User?             @relation("AppointmentDentist", fields: [dentistId], references: [id])
  resourceId            String?
  resource              Resource?         @relation(fields: [resourceId], references: [id])
  createdById           String
  createdBy             User              @relation("AppointmentCreatedBy", fields: [createdById], references: [id])
  type                  AppointmentType   @default(CONSULTATION)
  status                AppointmentStatus @default(SCHEDULED)
  startTime             DateTime
  endTime               DateTime
  notes                 String?
  cancelReason          String?
  googleCalendarEventId String?
  reminderSentAt        DateTime?
  /// Which treatment plan this appointment serves, when it was booked from one. Nullable: routine
  /// check-ups and emergencies belong to no plan.
  treatmentPlanId       String?
  treatmentPlan         TreatmentPlan?    @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  /// The itinerary line this booking realises, if it came from one.
  scheduleItem          TreatmentPlanScheduleItem?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([startTime])
  @@index([dentistId, startTime])
  @@index([treatmentPlanId])
  @@map("appointments")
}

// ─────────────────────────── TREATMENTS / FINANCE ───────────────────────────

model TreatmentCategory {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  items             TreatmentPlanItem[]
  warrantyTemplates WarrantyTemplate[]

  @@map("treatment_categories")
}

model TreatmentPlan {
  id                    String                @id @default(uuid())
  patientId             String
  patient               Patient               @relation(fields: [patientId], references: [id])
  createdById           String
  createdBy             User                  @relation("TreatmentPlanCreatedBy", fields: [createdById], references: [id])
  assignedDentistId     String?
  assignedDentist       User?                 @relation("TreatmentPlanDentist", fields: [assignedDentistId], references: [id])
  assignedCoordinatorId String?
  assignedCoordinator   User?                 @relation("TreatmentPlanCoordinator", fields: [assignedCoordinatorId], references: [id])
  title                 String
  status                TreatmentStatus       @default(PLANNED)
  totalCost             Decimal               @default(0) @db.Decimal(12, 2)
  currency              String                @default("USD")
  notes                 String?
  approvalStatus        PatientApprovalStatus @default(PENDING)
  approvedAt            DateTime?
  rejectionReason       String?
  doctorRecommendation  String?
  // Copied from Patient.diagnosis at creation so the patient-facing presentation
  // stays stable even if the live diagnosis changes later.
  diagnosisSnapshot     String?
  // Patient-friendly summary, staff-generated and cached (see Phase E AI module).
  aiSummary             String?
  // What the quoted price includes, as keys the dossier renders with its own labels. Held on the
  // plan, not only on the clinic: a proposal sent in March must still say what was promised in
  // March after the clinic changes its terms in June.
  packageIncludes       String[]              @default([])
  // Payment terms as quoted. Nullable throughout, because a zero would read as "no deposit
  // required" — a different promise from "not decided yet".
  depositAmount         Decimal?              @db.Decimal(12, 2)
  cardFeePercent        Decimal?              @db.Decimal(5, 2)
  cashDiscountPercent   Decimal?              @db.Decimal(5, 2)
  flightRefundNote      String?
  paymentTerms          String?
  // The language this dossier was issued in, so reissuing reproduces what was sent.
  language              String                @default("en")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  items         TreatmentPlanItem[]
  invoices      Invoice[]
  timelineSteps TreatmentTimelineStep[]
  comments      TreatmentPlanComment[]
  shareLinks    TreatmentPlanShareLink[]
  diagnoses     TreatmentPlanDiagnosis[]
  phases        TreatmentPlanPhase[]
  stay          TreatmentPlanStay?
  scheduleItems TreatmentPlanScheduleItem[]
  labOrders     LabOrder[]
  appointments  Appointment[]

  @@index([assignedDentistId])
  @@index([assignedCoordinatorId])
  @@index([patientId])
  @@map("treatment_plans")
}

// Travel and accommodation for a patient coming in from abroad. One per plan — a trip is the
// container the treatment happens inside, and a second trip is a second plan.
//
// Deliberately all optional: the coordinator learns the flight number days after the hotel is
// booked, and the dossier has to be printable at every stage of that. Sections with nothing in
// them are simply left out of the document rather than printed blank.
model TreatmentPlanStay {
  id              String        @id @default(uuid())
  treatmentPlanId String        @unique
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  arrivalDate     DateTime?
  arrivalFlight   String?
  departureDate   DateTime?
  departureFlight String?

  hotelName       String?
  hotelAddress    String?
  roomType        String?
  nights          Int?
  companions      Int?
  checkInDate     DateTime?
  checkOutDate    DateTime?

  // Free text rather than booleans: "hotel to clinic each morning, driver waits" is the useful
  // thing to print, and a checkbox cannot say it.
  airportTransfer String?
  clinicTransfer  String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("treatment_plan_stays")
}

// A single dated entry in the patient's itinerary — "Day 2, 10:00, implant surgery". Separate from
// TreatmentTimelineStep, which tracks plan progress with no fixed dates; this is the printed
// day-by-day the patient carries with them.
model TreatmentPlanScheduleItem {
  id              String        @id @default(uuid())
  treatmentPlanId String
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  date      DateTime
  // Kept as text ("09:30", "Morning") so an itinerary can be issued before exact times are set.
  time      String?
  title     String
  location  String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([treatmentPlanId])
  /// The booking that realises this line, once somebody has made one. Until then the itinerary
  /// promises a day the diary knows nothing about, which is the discrepancy this exists to show.
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@map("treatment_plan_schedule_items")
}

/// A case sent out to the laboratory.
///
/// Crowns, veneers and bridges are made externally, and this is where a dispatch is recorded: what
/// was sent, in what shade and material, when it is due back, and whether it has returned. Before
/// this, lab work existed only as a lump sum on the patient's case economics — a number with no
/// case behind it, so nobody could answer whether a bridge would be back before the patient flew
/// home without ringing the lab.
///
/// Attached to the plan rather than to one item: a dispatch usually carries several units, and
/// splitting it per tooth would mean chasing five orders for one parcel.
model LabOrder {
  id              String         @id @default(uuid())
  treatmentPlanId String
  treatmentPlan   TreatmentPlan  @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  labName         String
  status          LabOrderStatus @default(DRAFT)
  /// Shade and material are the two things a remake is usually caused by, so they are fields
  /// rather than something buried in a note.
  shade           String?
  material        String?
  /// FDI numbers this dispatch covers.
  toothNumbers    String[]       @default([])
  sentAt          DateTime?
  /// When the case is needed for the patient's appointment. This is what makes an order late
  /// rather than merely open.
  dueAt           DateTime?
  receivedAt      DateTime?
  trackingRef     String?
  notes           String?
  createdById     String
  createdBy       User           @relation("LabOrderCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([treatmentPlanId])
  @@index([status, dueAt])
  @@map("lab_orders")
}

// The patient's dental status as charted when the plan was drawn up. Held against the plan rather
// than the patient so the presented document stays fixed once shared — the same reasoning as
// TreatmentPlan.diagnosisSnapshot. One row is one finding across however many teeth show it, which
// is how it reads back to the patient ("Cavities — 11, 16, 25") and keeps the chart's job simple.
model TreatmentPlanDiagnosis {
  id              String         @id @default(uuid())
  treatmentPlanId String
  treatmentPlan   TreatmentPlan  @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  condition       ToothCondition
  // FDI tooth numbers. Free-form strings rather than an enum because some findings are not a tooth
  // at all — a sinus lift is recorded against "Right sinus" — matching TreatmentPlanItem.toothNumber.
  toothNumbers    String[]
  notes           String?
  createdAt       DateTime       @default(now())

  @@index([treatmentPlanId])
  @@map("treatment_plan_diagnoses")
}

// Per-phase extras. Line items carry their own phaseNumber and the subtotal is summed from them, so
// a phase row is only needed when a phase has a discount, a name, or a healing period — a plan with
// no rows here still renders correctly as a single phase.
model TreatmentPlanPhase {
  id                  String        @id @default(uuid())
  treatmentPlanId     String
  treatmentPlan       TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  phaseNumber         Int
  name                String?
  discountAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountPercent     Decimal?      @db.Decimal(5, 2)
  healingPeriodMonths Int?

  @@unique([treatmentPlanId, phaseNumber])
  @@map("treatment_plan_phases")
}

model TreatmentPlanItem {
  id                  String             @id @default(uuid())
  treatmentPlanId     String
  treatmentPlan       TreatmentPlan      @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  treatmentCategoryId String?
  treatmentCategory   TreatmentCategory? @relation(fields: [treatmentCategoryId], references: [id])
  toothNumber         String?
  description         String
  material            String?
  brand               String?
  quantity            Int                @default(1)
  // `cost` stays the authoritative line total that flows into TreatmentPlan.totalCost
  // and InvoiceItem. unitPrice/discount are additive input-convenience fields; the
  // frontend computes cost = unitPrice*quantity - discount and submits it.
  unitPrice           Decimal?           @db.Decimal(12, 2)
  discount            Decimal            @default(0) @db.Decimal(12, 2)
  cost                Decimal            @db.Decimal(12, 2)
  clinicalNotes       String?
  status              TreatmentStatus    @default(PLANNED)
  // Which stage of treatment this line belongs to (surgery first, prosthetics after healing, …).
  // A plain integer rather than a relation to TreatmentPlanPhase so an item is never blocked on a
  // phase row existing; see the note on that model.
  phaseNumber         Int                @default(1)
  // What this line does to the tooth, used to draw the proposed-treatment chart. Nullable because
  // it is inferred from the category or description when staff have not set it explicitly.
  toothCondition      ToothCondition?

  invoiceItems InvoiceItem[]
  warranties   Warranty[]

  // Postgres does not index a foreign key for you. Every plan detail view, every dossier render
  // and the warranties lookup that walks item -> plan -> patient all filter on this column.
  @@index([treatmentPlanId])
  @@index([treatmentCategoryId])
  @@map("treatment_plan_items")
}

model Invoice {
  id              String         @id @default(uuid())
  invoiceNumber   String         @unique
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id])
  treatmentPlanId String?
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
  status          InvoiceStatus  @default(DRAFT)
  subtotal        Decimal        @db.Decimal(12, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  tax             Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  currency        String         @default("USD")
  dueDate         DateTime?
  issuedAt        DateTime?
  createdById     String
  createdBy       User           @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items           InvoiceItem[]
  payments        Payment[]
  installmentPlan InstallmentPlan?

  @@index([status])
  @@index([patientId])
  @@map("invoices")
}

model InvoiceItem {
  id                  String             @id @default(uuid())
  invoiceId           String
  invoice             Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treatmentPlanItemId String?
  treatmentPlanItem   TreatmentPlanItem? @relation(fields: [treatmentPlanItemId], references: [id])
  description         String
  quantity            Int                @default(1)
  unitPrice           Decimal            @db.Decimal(12, 2)
  total               Decimal            @db.Decimal(12, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InstallmentPlan {
  id                   String               @id @default(uuid())
  invoiceId            String               @unique
  invoice              Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  numberOfInstallments Int
  frequency            InstallmentFrequency
  startDate            DateTime
  createdAt            DateTime             @default(now())

  schedules InstallmentSchedule[]

  @@map("installment_plans")
}

model InstallmentSchedule {
  id                String          @id @default(uuid())
  installmentPlanId String
  installmentPlan   InstallmentPlan @relation(fields: [installmentPlanId], references: [id], onDelete: Cascade)
  dueDate           DateTime
  amount            Decimal         @db.Decimal(12, 2)
  isPaid            Boolean         @default(false)
  paidAt            DateTime?
  paymentId         String?         @unique
  payment           Payment?        @relation(fields: [paymentId], references: [id])

  @@map("installment_schedules")
}

model Payment {
  id          String        @id @default(uuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD")
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  reference   String?
  createdById String
  createdBy   User          @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  installmentSchedule InstallmentSchedule?

  @@index([status, paidAt])
  @@index([invoiceId])
  @@map("payments")
}

// ─────────────────────────── COMMUNICATIONS ───────────────────────────

model Conversation {
  id               String              @id @default(uuid())
  channel          ConversationChannel
  patientId        String?
  patient          Patient?            @relation(fields: [patientId], references: [id])
  leadId           String?
  lead             Lead?               @relation(fields: [leadId], references: [id])
  externalThreadId String?
  assignedToId     String?
  assignedTo       User?               @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  lastMessageAt    DateTime?
  isArchived       Boolean             @default(false)
  createdAt        DateTime            @default(now())

  messages Message[]

  @@index([channel])
  @@map("conversations")
}

model Message {
  id                String           @id @default(uuid())
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection
  senderUserId      String?
  senderUser        User?            @relation("MessageSender", fields: [senderUserId], references: [id])
  content           String?
  mediaUrl          String?
  templateName      String?
  status            MessageStatus    @default(QUEUED)
  // Why a send failed, kept so staff can tell "the patient is ignoring us" from "our gateway is
  // down" without reading server logs.
  failureReason     String?
  externalMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime         @default(now())

  @@index([conversationId])
  @@map("messages")
}

model CallLog {
  id              String        @id @default(uuid())
  patientId       String?
  patient         Patient?      @relation(fields: [patientId], references: [id])
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id])
  userId          String
  user            User          @relation("CallLogUser", fields: [userId], references: [id])
  phoneNumber     String
  direction       CallDirection
  outcome         CallOutcome
  durationSeconds Int?
  recordingUrl    String?
  notes           String?
  occurredAt      DateTime
  createdAt       DateTime      @default(now())

  @@map("call_logs")
}

// ─────────────────────────── FILES ───────────────────────────

model File {
  id           String         @id @default(uuid())
  ownerType    AttachableType
  ownerId      String
  category     FileCategory   @default(OTHER)
  fileName     String
  mimeType     String
  sizeBytes    Int
  s3Bucket     String
  s3Key        String
  uploadedById String
  uploadedBy   User           @relation("FileUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  @@index([ownerType, ownerId])
  @@map("files")
}

// ─────────────────────────── NOTIFICATIONS / AUDIT ───────────────────────────

model Notification {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id])
  channel           NotificationChannel
  title             String
  body              String
  status            NotificationStatus  @default(PENDING)
  relatedEntityType String?
  relatedEntityId   String?
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([userId, status])
  @@map("notifications")
}

/// A single-use, time-limited password-reset link.
///
/// Only the hash is stored. The raw token exists in exactly two places — the email that was sent
/// and the URL the user clicks — so a leaked database read gives an attacker nothing usable, in
/// the same way the password column gives them nothing usable.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  // Kept rather than deleted after redemption, so "this link was already used" can be told apart
  // from "this link never existed". Cleared on the next successful reset for the account.
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  requestIp String?

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// One single-use code for getting back in when the authenticator app is gone.
///
/// Hashed, like a password, because possession of one is enough to bypass the second factor. A
/// phone is lost or wiped often enough that 2FA without a recovery path is 2FA that eventually
/// locks a clinic out of its own records.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  // Added with the audit interceptor. The table went from two writes per session to one per
  // clinical or financial mutation, so the two questions anyone actually asks of it — "what did
  // this person do" and "what happened that day" — needed to stop being sequential scans.
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────── TREATMENT PLAN & WARRANTY ───────────────────────────

model WarrantyTemplate {
  id                      String             @id @default(uuid())
  name                    String             @unique
  treatmentCategoryId     String?
  treatmentCategory       TreatmentCategory? @relation(fields: [treatmentCategoryId], references: [id])
  durationMonths          Int
  termsAndConditions      String
  maintenanceRequirements String?
  exclusions              String?
  annualCheckupRequired   Boolean            @default(false)
  isActive                Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  warranties Warranty[]

  @@map("warranty_templates")
}

model Warranty {
  id                      String            @id @default(uuid())
  treatmentPlanItemId     String
  treatmentPlanItem       TreatmentPlanItem @relation(fields: [treatmentPlanItemId], references: [id])
  warrantyTemplateId      String?
  warrantyTemplate        WarrantyTemplate? @relation(fields: [warrantyTemplateId], references: [id])
  startDate               DateTime
  durationMonths          Int
  status                  WarrantyStatus    @default(ACTIVE)
  // Snapshotted from the template at issuance so later template edits don't
  // retroactively change warranties already handed to a patient.
  termsAndConditions      String
  maintenanceRequirements String?
  exclusions              String?
  annualCheckupRequired   Boolean
  // Soft-reference to File.id (category WARRANTY_PDF), same polymorphic style as
  // File.ownerId — generated once at issue time.
  certificateFileId       String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([treatmentPlanItemId])
  @@map("warranties")
}

model TreatmentTimelineStep {
  id              String             @id @default(uuid())
  treatmentPlanId String
  treatmentPlan   TreatmentPlan      @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          TimelineStepStatus @default(PENDING)
  order           Int
  dueDate         DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([treatmentPlanId])
  @@map("treatment_timeline_steps")
}

model TreatmentPlanComment {
  id              String            @id @default(uuid())
  treatmentPlanId String
  treatmentPlan   TreatmentPlan     @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  authorType      CommentAuthorType
  authorUserId    String?
  authorUser      User?             @relation(fields: [authorUserId], references: [id])
  authorName      String?
  body            String
  createdAt       DateTime          @default(now())

  @@index([treatmentPlanId])
  @@map("treatment_plan_comments")
}

model TreatmentPlanShareLink {
  id              String        @id @default(uuid())
  treatmentPlanId String
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  // sha256(rawToken) — deterministic hash for WHERE tokenHash = ? lookups on a
  // public link that has no prior identifying context (unlike refresh tokens).
  tokenHash       String        @unique
  expiresAt       DateTime?
  revokedAt       DateTime?
  lastViewedAt    DateTime?
  createdById     String
  createdBy       User          @relation("ShareLinkCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([treatmentPlanId])
  @@map("treatment_plan_share_links")
}
